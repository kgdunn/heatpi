# Logs the Grove temperature & humidity sensor once a minute into the same SQLite file.
#   sudo cp room-logger.service /etc/systemd/system/
#   sudo systemctl enable --now room-logger
[Unit]
Description=Room temperature and humidity logger

[Service]
User=kevindunn
WorkingDirectory=/home/kevindunn/p1-logger
ExecStart=/usr/bin/python3 room_logger.py --db p1.sqlite
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
